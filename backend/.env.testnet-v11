# ── Ufama v1.1 TESTNET staging environment ──
# Swap in with:  cd backend && cp .env .env.mainnet-backup && cp .env.testnet-v11 .env
# Swap back:     cp .env.mainnet-backup .env
# Deployed 2026-08-22 from main (v1.1 contracts). Testnet resets quarterly.

PORT=3001
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL=https://horizon-testnet.stellar.org
AQUA_API_URL=https://amm-api-testnet.aqua.network/api/external/v1

# v1.1 testnet contract set
SWAPBOOK_CONTRACT_ID=CDZUTPVH2X7FLPNRYOYWO4XMIW7QLNJVPUBTEH3VL4CFDAZC3SANE6YD
ROUTER_CONTRACT_ID=CDKCV2V5HUYJJABCERKSX3P5Z7N4XNQRGGWDFBCXVW5SV2ETRLTPNW4I
FEE_VAULT_CONTRACT_ID=CBH6XGVDQ2KINIMODP4JWMG5WU45PZYWX75IYHKHVLXJ2KXVBBVSHLTM
TWAP_BOOK_CONTRACT_ID=CDPTBN2YFGOB4YOMLWX7CDXVQBH2WYQDJBZCZLMJNIALRSB3ZWLQVV62
AQUA_ADAPTER_CONTRACT_ID=CAN4V4KT7LCGHS3HNA2QS7GY4BDJT2BCSX4JLRBVSUMEPRL2MHYDTHG7
# No Sushi on testnet
SUSHI_ADAPTER_CONTRACT_ID=

# v1.1 features ON — this is the whole point of the staging pass
SWAPBOOK_V11=1

# Test assets (issued by the testnet deployer; survive until testnet reset)
TOKEN_USDC_SAC=CCJITNYWJYT6UPLARMRSANJM64IPITYSQRPA23HIBQ2QXV3RDF6IBQ62
TOKEN_USDT0_SAC=CBTCXHCZKXS6WD4YESQLSKLTWJBB5VIGORXWTDLRA3NJ2TS7RPIUR3L2
P2P_ALLOWED_TOKENS=USDC,USDT0

# Disable Sushi discovery on testnet (mainnet-only pools would pollute the list)
SUSHI_GRAPHQL_URL=

# Keeper/oracle: reuse the testnet deployer for local testing only —
# NEVER do this on mainnet (roles are separated there on purpose).
# Paste from `stellar keys show deployer` if you want the keeper running:
KEEPER_SECRET_KEY=
ORACLE_SECRET_KEY=
