# Stellar Network — defaults match the server's testnet defaults.
# For mainnet use:
#   SOROBAN_RPC_URL=<your RPC provider — SDF runs no free public mainnet RPC>
#   HORIZON_URL=https://horizon.stellar.org
#   NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract Addresses (deploy and fill in)
SWAPBOOK_CONTRACT_ID=
ROUTER_CONTRACT_ID=
FEE_VAULT_CONTRACT_ID=
AQUA_ADAPTER_CONTRACT_ID=
# Do NOT set until SushiSwap's Soroban ABI is verified (adapter is a placeholder)
SUSHI_ADAPTER_CONTRACT_ID=

# External DEX Contracts
# Aqua router mainnet: CBQDHNBFBZYE4MKPWBSJOPIYLW4SFSXAXUTSXJN76GNKYVYPCKWC6QUK
# Aqua router testnet: CDGX6Q3ZZIDSX2N3SHBORWUIEG2ZZEBAAMYARAXTT7M5L6IXKNJMT3GB
AQUA_ROUTER_CONTRACT=CDGX6Q3ZZIDSX2N3SHBORWUIEG2ZZEBAAMYARAXTT7M5L6IXKNJMT3GB
AQUA_API_URL=https://amm-api-testnet.aqua.network/api/external/v1

# Database
DATABASE_URL=postgresql://localhost:5432/atomicswap

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=3001
WS_PORT=3002

# CORS — comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:3000,https://your-app.vercel.app

# ─── Service keys (keep out of git; use your platform's secret store) ───

# Signs update_oracle_price transactions. Must match the on-chain
# oracle admin set via SwapBook.set_oracle_admin. Omit to run the
# oracle in cache-only mode (no on-chain pushes).
ORACLE_SECRET_KEY=

# Signs route_expired_order keeper transactions. This key holds NO
# custody and NO privileges — route_expired_order is permissionless;
# any funded account works. Omit for dry-run sweeps.
KEEPER_SECRET_KEY=

# TWAP order book (time-weighted execution)
TWAP_BOOK_CONTRACT_ID=

# Sushi pair registry (JSON): [{"tokenA","tokenB","pool","fee"}]
SUSHI_PAIRS=
TOKEN_PYUSD_SAC=

# Aqua pair registry mirror (for TWAP eligibility): [{"tokenA","tokenB","pool","fee"}]
AQUA_PAIRS=

# v1.1 SwapBook features (match_and_place, excluded counterparties).
# Leave unset until the v1.1 contracts are deployed and
# SWAPBOOK_CONTRACT_ID points at them.
SWAPBOOK_V11=

# Protocol-operated liquidity wallets, comma-separated G... addresses.
# Peer-swap plans prefer organic makers and fall back to these; with
# SWAPBOOK_V11 their orders auto-exclude each other on-chain.
SDF_LIQUIDITY_WALLETS=

# Wallet screening (off-chain compliance; contracts stay permissionless).
# SCREENING_PROVIDER: none (default) | denylist | predicate
SCREENING_PROVIDER=
SCREENING_DENYLIST=
PREDICATE_API_URL=
PREDICATE_API_KEY=
# Set to 1 to block builds when the screening provider is unreachable
SCREENING_FAIL_CLOSED=

# Sushi pool/token discovery (GraphQL endpoint sushi.com itself uses).
# Set empty to disable. Tokens/pools below the liquidity floor are ignored.
SUSHI_GRAPHQL_URL=https://production.data-gcp.sushi.com/api/graphql
SUSHI_MIN_LIQUIDITY_USD=500

# ── RPC resilience ─────────────────────────────────────────
# Secondary RPCs tried automatically when the primary fails at the
# transport level (DNS/TLS/timeout/5xx/429). Comma-separated. On mainnet
# this DEFAULTS to the free public endpoints below when unset; set it to
# an empty string to disable failover. /api/health reports which endpoint
# live traffic is using ("rpc.active") and probes the primary each call.
# SOROBAN_RPC_FALLBACK_URL=https://mainnet.sorobanrpc.com,https://soroban-rpc.mainnet.stellar.gateway.fm
# RPC_TIMEOUT_MS=12000            # per-call cap before failing over
# RPC_FAILOVER_COOLDOWN_MS=60000  # how long a failed endpoint is skipped
# RPC_PROBE_TIMEOUT_MS=3000       # /api/health primary probe cap

# ── Price-impact guard ─────────────────────────────────────
# Quotes above WARN carry priceImpactWarning (UI banner); builds above MAX
# are refused with a 400 (and quotes carry priceImpactBlocked).
# PRICE_IMPACT_WARN_BPS=300
# PRICE_IMPACT_MAX_BPS=1500
